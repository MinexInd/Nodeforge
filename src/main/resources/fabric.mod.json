{
	"schemaVersion": 1,
	"id": "nodeforge",
	"version": "${version}",
	"name": "NodeForge",
	"description": "A reusable Minecraft Fabric library for building node-based editors, visual programming systems, skill trees, and other graph-based interfaces.",
	"authors": [
		"MinexInd"
	],
	"contact": {
		"homepage": "https://github.com/MinexInd/Nodeforge",
		"sources": "https://github.com/MinexInd/Nodeforge"
	},
	"license": "MIT",
	"icon": "assets/nodeforge/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.minex.nodeforge.NodeForge"
		],
		"client": [
			"net.minex.nodeforge.client.NodeForgeClient"
		]
	},
	"mixins": [
		"nodeforge.mixins.json",
		{
			"config": "nodeforge.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}